node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Python Virtual Environments & Packages
.venv/
venv/
env/
.Python
*.egg-info/
dist/
build/
_pydeps/

# Python Bytecode & Cache
__pycache__/
*.py[cod]
*$py.class
*.so

