# Runtime Databases & Local Storage
# ============================================================
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
backend/*.db*

# Uploads & Runtime Generated Results
uploads/
backend/uploads/
outputs/
backend/outputs/
backend/data/results/*.png
backend/data/results/*.jpg
backend/data/cache/

# ============================================================
# Datasets (Do NOT commit large datasets or parquet files)
# ============================================================
*.parquet
LEVIR-CD/
*LEVIR-CD*/
BigEarthNet/

# ============================================================
# Environment Files & Secrets (NEVER commit secrets or real envs)
# ============================================================
.env
.env.*
*.env
backend/.env
backend/.env.*
!.env.example
!backend/.env.example

# ============================================================
# Logs & Debug
# ============================================================
logs/
backend/logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ============================================================
