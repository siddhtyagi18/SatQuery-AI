# ============================================================
# SatQuery-AI Backend - Environment Configuration
# Phase 2: Firebase + Real VQA Model Support
# Copy this file to .env and adjust values for your environment.
# ============================================================

# ---------- App ----------
APP_NAME=SatQuery-AI Backend
APP_VERSION=0.2.0-phase2
DEBUG=true
HOST=0.0.0.0
PORT=8000

# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# ---------- Database (SQLite for local dev) ----------
DATABASE_URL=sqlite:///./satquery.db

# ---------- Uploads ----------
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=512
# Comma-separated allowed extensions
ALLOWED_EXTENSIONS=.tif,.tiff,.png,.jpg,.jpeg

# ---------- Storage Backend ----------
# Values: "local" or "firebase"
STORAGE_BACKEND=local

# ============================================================
# FIREBASE INTEGRATION (Phase 2 — optional, keep disabled for pure local dev)
# ============================================================
# Set to true to enable Firestore + Firebase Storage persistence.
# When false, the system operates entirely on the local SQLite database.
FIREBASE_ENABLED=false

# Firebase project id (required if FIREBASE_ENABLED=true)
FIREBASE_PROJECT_ID=your-firebase-project-id

# Firebase Cloud Storage bucket, e.g. "your-project.appspot.com"
FIREBASE_STORAGE_BUCKET=your-project.appspot.com

# Service account JSON — either inline JSON string OR @/path/to/service-account.json
# NEVER commit real credentials to version control.
# Example (inline JSON):
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"...","client_email":"...","client_id":"...","auth_uri":"...","token_uri":"...","auth_provider_x509_cert_url":"...","client_x509_cert_url":"..."}
# Example (file path):
# FIREBASE_SERVICE_ACCOUNT_JSON=@/absolute/path/to/service-account.json
FIREBASE_SERVICE_ACCOUNT_JSON=

# Firestore collection name for analysis records
FIREBASE_COLLECTION_ANALYSES=analyses

# ============================================================
# REAL VQA MODEL CONFIGURATION (Phase 2)
# ============================================================
# Controls when the real VQA service is used:
#   "real"  — always use the real model (fallback to mock on failure)
#   "mock"  — always use mock services
#   "auto"  — use real VQA for single-image VQA, mock for everything else (recommended)
VQA_MODE=auto

# HuggingFace model id. Recommended default (500M params, CPU-runnable, Apache 2.0):
#   HuggingFaceTB/SmolVLM-500M-Instruct
VQA_MODEL_ID=HuggingFaceTB/SmolVLM-500M-Instruct

# Inference device: "cpu" or "cuda" (if GPU + torch CUDA available)
VQA_DEVICE=cpu

# Precision: "fp32" (safe, CPU), "fp16" / "bf16" (GPU recommended)
VQA_PRECISION=fp32

# Generation config
VQA_MAX_NEW_TOKENS=512
VQA_TEMPERATURE=0.2

# Inference timeout for a single VQA call (seconds)
VQA_INFERENCE_TIMEOUT_SEC=180

# HuggingFace cache override. Leave empty to use default HF cache dir.
VQA_CACHE_DIR=

# Optional HuggingFace token for gated / rate-limited model downloads
# Get one from https://huggingface.co/settings/tokens
VQA_HF_TOKEN=

# ---------- Global inference timeout ----------
INFERENCE_REQUEST_TIMEOUT_SEC=240

# ============================================================
# DATASETS & CHANGE DETECTION MODEL (Phase 3)
# ============================================================
# LEVIR-CD root directory (extracted folder containing train/val/test splits)
# Either LEVIR_CD_DATASET_PATH or LEVIR_CD_ROOT can be used.
# Directory layout:
#   <LEVIR_CD_DATASET_PATH>/
#   ├── train/  {A, B, label}
#   ├── val/    {A, B, label}
#   └── test/   {A, B, label}
LEVIR_CD_DATASET_PATH=
LEVIR_CD_ROOT=

# BigEarthNet VQA text annotations and patch metadata (Parquet format)
# Note: BigEarthNet.txt.parquet contains text QA annotations, NOT image pixels.
BIGEARTHNET_TXT_PARQUET=
BIGEARTHNET_METADATA_PARQUET=

# Optional local cache directory for datasets
DATASET_CACHE_DIR=./data/cache

# Directory to save/load trained model checkpoints
CHECKPOINT_DIR=./checkpoints

# Path to trained SiameseUNet checkpoint file (e.g. ./checkpoints/best_model.pt)
# When set and file exists, change detection runs the trained model via tiled inference.
# When unset or missing, change detection runs the CPU classical difference baseline.
CHANGE_DETECTION_CHECKPOINT=./checkpoints/best_model.pt
