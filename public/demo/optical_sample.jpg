<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 600" width="100%" height="100%">
  <defs>
    <radialGradient id="spaceGlow" cx="50%" cy="50%" r="75%">
      <stop offset="0%" stop-color="#0c2340"/>
      <stop offset="60%" stop-color="#081426"/>
      <stop offset="100%" stop-color="#040812"/>
    </radialGradient>
    <pattern id="grid" width="40" height="40" patternUnits="userSpaceOnUse">
      <rect width="40" height="40" fill="none"/>
      <path d="M 40 0 L 0 0 0 40" fill="none" stroke="rgba(62,208,255,0.1)" stroke-width="1"/>
    </pattern>
  </defs>
  <rect width="100%" height="100%" fill="url(#spaceGlow)"/>
  <rect width="100%" height="100%" fill="url(#grid)"/>
  
  <!-- Farmlands / Fields -->
  <polygon points="40,80 220,60 260,220 60,240" fill="#1b4d3e" opacity="0.6"/>
  <polygon points="230,50 420,40 450,210 270,220" fill="#2d5a27" opacity="0.7"/>
  <polygon points="50,250 250,230 280,480 70,510" fill="#1e3f20" opacity="0.75"/>
  <polygon points="260,230 460,220 480,460 290,470" fill="#326b38" opacity="0.6"/>
  
  <!-- Urban Grid / Built-up area -->
  <g fill="#4a5568" opacity="0.85" stroke="#718096" stroke-width="1">
    <rect x="520" y="80" width="45" height="35"/>
    <rect x="580" y="75" width="50" height="40"/>
    <rect x="645" y="85" width="40" height="30"/>
    <rect x="515" y="130" width="55" height="40"/>
    <rect x="585" y="125" width="45" height="45"/>
    <rect x="640" y="130" width="60" height="40"/>
    <rect x="520" y="185" width="60" height="35"/>
    <rect x="590" y="180" width="50" height="40"/>
    <rect x="650" y="185" width="45" height="35"/>
    <rect x="530" y="235" width="40" height="30"/>
    <rect x="580" y="230" width="55" height="40"/>
    <rect x="645" y="235" width="50" height="35"/>
  </g>
  
  <!-- Road Network -->
  <path d="M 490 20 L 500 580" stroke="#cbd5e1" stroke-width="6" fill="none" opacity="0.9"/>
  <path d="M 20 225 L 780 225" stroke="#cbd5e1" stroke-width="5" fill="none" opacity="0.9"/>
  <path d="M 20 465 L 780 465" stroke="#94a3b8" stroke-width="3" fill="none" opacity="0.7"/>
  
  <!-- Water Reservoir -->
  <path d="M 540 340 Q 640 310 720 380 Q 760 480 680 540 Q 560 560 520 480 Z" fill="#0284c7" opacity="0.85" stroke="#38bdf8" stroke-width="2"/>
  
  <!-- HUD Text Overlay -->
  <text x="30" y="40" fill="#3ed0ff" font-family="monospace" font-size="14" font-weight="bold">ISRO RESOURCESAT-2 LISS-IV [OPTICAL 5.8m]</text>
  <text x="30" y="570" fill="#8b93a7" font-family="monospace" font-size="11">LAT 17.448°N LON 78.391°E · EPSG:32643 · 2024-03-15</text>
</svg>
